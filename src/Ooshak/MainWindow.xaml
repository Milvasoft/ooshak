<Window x:Class="Ooshak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ooshak"
        Title="Ooshak"
        Width="1000" Height="680" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/ooshak.ico"
        Background="{StaticResource Ink900}"
        Foreground="{StaticResource Paper}"
        FontFamily="{StaticResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Ink800}" BorderBrush="{StaticResource Ink600}" BorderThickness="0,0,1,0">
            <Grid Margin="14,16,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,26">
                    <Image Source="{StaticResource LogoTile}" Width="34" Height="34" />
                    <TextBlock Text="Ooshak" Margin="11,0,0,1" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Row="1" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Content="{local:T 'Durum'}" Tag="&#xE720;" IsChecked="True" GroupName="Nav" Checked="OnNavigate" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="{local:T 'Ayarlar'}" Tag="&#xE713;" GroupName="Nav" Checked="OnNavigate" />
                    <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" Content="{local:T 'Günlük'}" Tag="&#xE8FD;" GroupName="Nav" Checked="OnNavigate" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Ellipse x:Name="SideDot" Width="9" Height="9" Fill="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SideStatus" Margin="9,0,0,0" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowAction}" Content="&#xE921;" Click="OnMinimize" ToolTip="{local:T 'Küçült'}" AutomationProperties.Name="{local:T 'Küçült'}" />
                <Button Style="{StaticResource WindowAction}" Content="&#xE922;" Click="OnMaximize" ToolTip="{local:T 'Büyüt'}" AutomationProperties.Name="{local:T 'Büyüt'}" />
                <Button Style="{StaticResource WindowAction}" Content="&#xE8BB;" Click="OnClose" ToolTip="{local:T 'Tepsiye gizle'}" AutomationProperties.Name="{local:T 'Tepsiye gizle'}" />
            </StackPanel>

            <!-- Durum -->
            <Grid x:Name="PageHome" Grid.Row="1" Margin="30,0,30,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="240" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="SetupCard" CornerRadius="16" Background="{StaticResource Ink800}" BorderBrush="{StaticResource Ink600}" BorderThickness="1" Padding="32,28" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Hoş geldin'}" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Body}" FontSize="15" Margin="0,10,0,0" MaxWidth="620" HorizontalAlignment="Left" Text="{local:T 'Ooshak konuşmanı bu bilgisayarda tanır ve cevapları burada okur, sesin dışarı gönderilmez. Bunun için bir kez yaklaşık 1,8 GB model indirilecek: Whisper, Silero ve Piper sesleri. Kaynaklar Hugging Face ve GitHub, her dosya özetiyle doğrulanır.'}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" MaxWidth="620" HorizontalAlignment="Left" Text="{local:T 'Türkçe ses modeli yalnızca ticari olmayan kullanım için lisanslıdır (CC BY-NC-SA 4.0).'}" />
                        <ProgressBar x:Name="SetupProgress" Height="6" Margin="0,22,0,8" Maximum="1" Visibility="Collapsed" />
                        <TextBlock x:Name="SetupStatus" Style="{StaticResource Hint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="SetupButton" Style="{StaticResource PrimaryAction}" Content="{local:T 'Modelleri indir'}" Click="OnInstallModels" />
                            <Button x:Name="SetupConnectButton" Style="{StaticResource GhostAction}" Margin="10,0,0,0" Content="{local:T 'Claude Code\'a bağla'}" Click="OnSetupConnect" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="HeroCard" CornerRadius="16" Background="{StaticResource Ink800}" BorderBrush="{StaticResource Ink600}" BorderThickness="1">
                    <Grid>
                        <local:LiquidView x:Name="HeroLiquid" CornerRadius="16" MinFill="0.16" MaxFill="0.72" Opacity="0.62" />
                        <Grid Margin="32,28,32,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="SemiBold" />
                                <TextBlock x:Name="HeroSubtitle" Style="{StaticResource Body}" FontSize="15" Margin="0,6,0,0" MaxWidth="470" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Button x:Name="MicButton" Grid.Column="1" Style="{StaticResource MicAction}" VerticalAlignment="Top" Click="OnToggleMute" AutomationProperties.Name="{local:T 'Mikrofonu aç veya kapat'}" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Hedef oturum'}" Style="{StaticResource Eyebrow}" />
                            <TextBlock x:Name="TargetText" Style="{StaticResource CardTitle}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Son komut'}" Style="{StaticResource Eyebrow}" />
                            <TextBlock x:Name="LastCommandText" Style="{StaticResource CardTitle}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{local:T 'Bekleyen cevap'}" Style="{StaticResource Eyebrow}" />
                            <TextBlock x:Name="AwaitingText" Style="{StaticResource CardTitle}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="{local:T 'Ctrl+Alt+M mikrofonu açar ve kapatır, Ctrl+Alt+S okumayı duraklatır ve sürdürür.'}" />
                    <Button x:Name="ReadingButton" Grid.Column="1" Style="{StaticResource GhostAction}" Content="{local:T 'Okumayı durdur'}" Click="OnStopSpeaking" />
                </Grid>
            </Grid>

            <!-- Ayarlar -->
            <Grid x:Name="PageSettings" Grid.Row="1" Margin="30,0,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:T 'Ayarlar'}" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,30,16">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Dil'}" Style="{StaticResource CardTitle}" />
                                <ComboBox x:Name="LanguageBox" Margin="0,10,0,18" AutomationProperties.Name="{local:T 'Dil'}">
                                    <ComboBoxItem Content="{local:T 'Türkçe'}" />
                                    <ComboBoxItem Content="{local:T 'English'}" />
                                </ComboBox>
                                <TextBlock Text="{local:T 'Sana nasıl hitap edeyim'}" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="{local:T 'Buraya yalnızca hitabı yaz, örneğin patron veya efendim. Sesle değiştirmek için çağrı adınla birlikte “bana patron de” demen yeterli.'}" />
                                <TextBox x:Name="AddressBox" Margin="0,0,0,18" AutomationProperties.Name="{local:T 'Hitap'}" />
                                <TextBlock Text="{local:T 'Çağrı adı'}" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12" Text="{local:T 'Ooshak\'a böyle seslenirsin. Virgülle birden fazla yazım ekleyebilirsin. En iyisi sesinle öğretmek.'}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WakeNamesBox" AutomationProperties.Name="{local:T 'Çağrı adları'}" />
                                    <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource GhostAction}" Content="{local:T 'Sesimle öğret'}" Click="OnStartEnrollment" />
                                </Grid>
                                <Border x:Name="EnrollPanel" Margin="0,14,0,0" Padding="16,14" CornerRadius="10" Background="{StaticResource Ink800}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="EnrollStatus" Style="{StaticResource Body}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                                            <Ellipse x:Name="EnrollDot1" Width="14" Height="14" Fill="{StaticResource Ink600}" Margin="0,0,8,0" />
                                            <Ellipse x:Name="EnrollDot2" Width="14" Height="14" Fill="{StaticResource Ink600}" Margin="0,0,8,0" />
                                            <Ellipse x:Name="EnrollDot3" Width="14" Height="14" Fill="{StaticResource Ink600}" Margin="0,0,14,0" />
                                            <TextBlock x:Name="EnrollHeard" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="EnrollSave" Style="{StaticResource PrimaryAction}" Content="{local:T 'Bunu kullan'}" IsEnabled="False" Click="OnSaveEnrollment" />
                                            <Button Margin="8,0,0,0" Style="{StaticResource GhostAction}" Content="{local:T 'Baştan al'}" Click="OnRestartEnrollment" />
                                            <Button Margin="8,0,0,0" Style="{StaticResource GhostAction}" Content="{local:T 'Vazgeç'}" Click="OnCancelEnrollment" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Hangi cevaplar okunsun'}" Style="{StaticResource CardTitle}" />
                                <ComboBox x:Name="ReplyModeBox" Margin="0,10,0,16" SelectionChanged="OnReplyModeChanged" AutomationProperties.Name="{local:T 'Hangi cevaplar okunsun'}">
                                    <ComboBoxItem Content="{local:T 'Sadece sesle başlattıklarım'}" />
                                    <ComboBoxItem Content="{local:T 'Ekranda açık olan oturum'}" />
                                    <ComboBoxItem Content="{local:T 'Tüm oturumlar'}" />
                                    <ComboBoxItem Content="{local:T 'Seçtiğim oturum (aracı)'}" />
                                </ComboBox>
                                <StackPanel x:Name="MediatorPanel" Margin="0,0,0,16" Visibility="Collapsed">
                                    <TextBlock Text="{local:T 'Aracı oturum'}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="{local:T 'Söylediğin her şey bu oturuma gider, yalnızca onun cevabı okunur. Başka oturumlara işi o iletir.'}" />
                                    <ComboBox x:Name="MediatorBox" AutomationProperties.Name="{local:T 'Aracı oturum'}" />
                                </StackPanel>
                                <TextBlock Text="{local:T 'Asistan tarzı'}" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="{local:T 'Her oturuma yalnızca ilk sesli mesajda gönderilir. Oturum, 🔊 ile başlayan satırı senin için yazar, Ooshak onu okur. Boş bırakırsan özet okunur.'}" />
                                <TextBox x:Name="AssistantStyleBox" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="64" Margin="0,0,0,16" AutomationProperties.Name="{local:T 'Asistan tarzı'}" />
                                <Grid>
                                    <TextBlock Text="{local:T 'Cevaptan sonra isimsiz devam'}" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="FollowUpValue" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{local:T 'Cevap okunduktan sonra bu süre içinde söylediğin tek cümle, çağrı adı olmadan son oturuma gider.'}" />
                                <Slider x:Name="FollowUpSlider" Margin="0,8,0,16" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnFollowUpChanged" AutomationProperties.Name="{local:T 'İsimsiz devam süresi'}" />
                                <Grid>
                                    <TextBlock Text="{local:T 'Okuma hızı'}" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="RateValue" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="RateSlider" Margin="0,8,0,16" Minimum="0.7" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnRateChanged" AutomationProperties.Name="{local:T 'Okuma hızı'}" />
                                <StackPanel x:Name="PronunciationPanel">
                                    <TextBlock Text="{local:T 'Okunuşlar'}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12" Text="{local:T 'Yaygın İngilizce kelimeler zaten doğru okunur. Yanlış okunanı buraya “kelime = okunuşu” diye yaz.'}" />
                                    <TextBox x:Name="PronunciationBox" AcceptsReturn="True" MinHeight="96" MaxHeight="180" FontFamily="{StaticResource MonoFont}" FontSize="13" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:T 'Okunuşlar'}" />
                                </StackPanel>
                                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource GhostAction}" Content="{local:T 'Örneği dinle'}" Click="OnPreviewSpeech" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Mikrofon'}" Style="{StaticResource CardTitle}" />
                                <ComboBox x:Name="MicrophoneBox" Margin="0,10,0,14" AutomationProperties.Name="{local:T 'Mikrofon'}" />
                                <Grid>
                                    <TextBlock Text="{local:T 'Cümle bitti saymadan önce sessizlik'}" Style="{StaticResource Body}" />
                                    <TextBlock x:Name="SilenceValue" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="SilenceSlider" Margin="0,8,0,0" Minimum="400" Maximum="1600" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="OnSilenceChanged" AutomationProperties.Name="{local:T 'Sessizlik süresi'}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Genel oturum'}" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10" Text="{local:T 'Oturum adı söylemediğin sohbetler buraya gider. “Genele geç” dersen hemen buna dönersin.'}" />
                                <ComboBox x:Name="GeneralSessionBox" Margin="0,0,0,14" AutomationProperties.Name="{local:T 'Genel oturum'}" />
                                <Grid>
                                    <TextBlock Text="{local:T 'Son oturumda kalma süresi'}" Style="{StaticResource Body}" />
                                    <TextBlock x:Name="StickyValue" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="StickySlider" Margin="0,8,0,18" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnStickyChanged" AutomationProperties.Name="{local:T 'Son oturumda kalma süresi'}" />
                                <TextBlock Text="{local:T 'Oturum takma adları'}" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12" Text="{local:T 'Söylediğin kısa ad ve gideceği oturum. Aynı adla başlayan birden çok oturum varsa gerekir.'}" />
                                <ItemsControl x:Name="AliasList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:T 'Takma ad'}" />
                                                <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding Sessions}" SelectedItem="{Binding Title}" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:T 'Oturum'}" />
                                                <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource GhostAction}" Padding="11,0" FontFamily="{StaticResource IconFont}" FontSize="12" Content="&#xE74D;" Click="OnRemoveAlias" ToolTip="{local:T 'Sil'}" AutomationProperties.Name="{local:T 'Takma adı sil'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource GhostAction}" HorizontalAlignment="Left" Content="{local:T 'Takma ad ekle'}" Click="OnAddAlias" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{local:T 'Teknik kelimeler'}" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12" Text="{local:T 'Türkçe konuşurken İngilizce söylediğin terimler ve proje adları. Ooshak bunları olduğu gibi yazmaya çalışır.'}" />
                                <TextBox x:Name="VocabularyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:T 'Teknik kelimeler'}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,70,0">
                                        <TextBlock Text="{local:T 'Yüzen ada'}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="{local:T 'Pencere küçükken ekranda durur. Sürükleyip taşı, çift tıkla aç.'}" />
                                    </StackPanel>
                                    <CheckBox x:Name="IslandSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Yüzen ada'}" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,70,0">
                                        <TextBlock Text="{local:T 'Tam ekranda otomatik duraklat'}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="{local:T 'Oyun veya tam ekran video açıkken dinleme ve okuma durur, çıkınca kendiliğinden devam eder.'}" />
                                    </StackPanel>
                                    <CheckBox x:Name="AutoPauseSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Tam ekranda otomatik duraklat'}" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,70,0">
                                        <TextBlock Text="{local:T 'İzinleri popup ile sor'}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="{local:T 'Oturumların izin isteklerini ekranda gösterir. 55 saniyede yanıtlamazsan istek Claude penceresine düşer.'}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PermissionSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'İzinleri popup ile sor'}" />
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="{local:T 'Windows ile başlat'}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{local:T 'Windows ile başlat'}" />
                                </Grid>
                                <Grid>
                                    <StackPanel Margin="0,0,150,0">
                                        <TextBlock Text="{local:T 'Claude Code bağlantısı'}" Style="{StaticResource CardTitle}" />
                                        <TextBlock x:Name="HookStatus" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button x:Name="HookButton" Style="{StaticResource GhostAction}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnToggleHooks" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource Ink600}" BorderThickness="0,1,0,0" Padding="0,12,30,14">
                    <Grid>
                        <TextBlock x:Name="SaveStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PrimaryAction}" HorizontalAlignment="Right" Content="{local:T 'Kaydet'}" Click="OnSaveSettings" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Günlük -->
            <Grid x:Name="PageLog" Grid.Row="1" Margin="30,0,30,26" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="{local:T 'Günlük'}" Style="{StaticResource PageTitle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostAction}" Content="{local:T 'Klasörü aç'}" Click="OnOpenLogFolder" />
                        <Button Margin="8,0,0,0" Style="{StaticResource GhostAction}" Content="{local:T 'Temizle'}" Click="OnClearLog" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                    <Grid>
                        <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="LogEmpty" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{local:T 'Henüz kayıt yok. Sesli komut verdikçe burada görünür.'}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
