<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0-windows drives the Windows app; plain net10.0 is the macOS build. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <Compile Remove="Windows\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Remove="Mac\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\SpeechTerms.txt" LogicalName="Ooshak.Core.SpeechTerms.txt" />
    <EmbeddedResource Include="Resources\EnglishPronunciations.txt" LogicalName="Ooshak.Core.EnglishPronunciations.txt" />
  </ItemGroup>

</Project>
