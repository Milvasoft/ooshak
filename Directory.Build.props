<Project>
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Product>Ooshak</Product>
    <Company>Milvasoft</Company>
    <Authors>Milvasoft</Authors>
    <Copyright>Copyright © 2026 Milvasoft</Copyright>
    <RepositoryUrl>https://github.com/Milvasoft/ooshak</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Lets the shared projects restore their Windows target on the macOS build agent. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
